{
  "name": "asksuite-test",
  "version": "1.0.0",
  "description": "Hotel room search API with web scraping - Asksuite Technical Test",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --coverage --verbose",
    "test:watch": "jest --watch",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:integration": "jest --testPathPattern=tests/integration",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f backend",
    "docker:build": "docker-compose build",
    "docker:restart": "docker-compose restart backend"
  },
  "keywords": [
    "hotel",
    "scraping",
    "puppeteer",
    "express",
    "api",
    "asksuite"
  ],
  "author": "Felippe Freire",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "pg": "^8.11.3",
    "puppeteer": "^21.8.0",
    "redis": "^4.6.12"
  },
  "devDependencies": {
    "nodemon": "^3.0.3",
    "jest": "^29.7.0",
    "supertest": "^6.3.4",
    "@types/jest": "^29.5.11"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
