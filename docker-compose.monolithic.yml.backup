version: '3.8'

services:
  # Backend Node.js API
  backend:
    build:
      context: .
      dockerfile: Dockerfile
    container_name: asksuite-backend
    restart: unless-stopped
    ports:
      - "${PORT:-8080}:${PORT:-8080}"
    environment:
      - NODE_ENV=${NODE_ENV:-development}
      - PORT=${PORT:-8080}
      - DATABASE_URL=postgresql://${DB_USER:-asksuite}:${DB_PASSWORD:-asksuite123}@postgres:5432/${DB_NAME:-asksuite_db}
      - REDIS_URL=redis://redis:6379
      - REDIS_TTL=${REDIS_TTL:-3600}
    depends_on:
      - postgres
      - redis
    volumes:
      - .:/app
      - /app/node_modules
    networks:
      - asksuite-network
    shm_size: '2gb'
    cap_add:
      - SYS_ADMIN
    command: npm run dev

  # PostgreSQL Database
  postgres:
    image: postgres:15-alpine
    container_name: asksuite-postgres
    restart: unless-stopped
    environment:
      - POSTGRES_USER=${DB_USER:-asksuite}
      - POSTGRES_PASSWORD=${DB_PASSWORD:-asksuite123}
      - POSTGRES_DB=${DB_NAME:-asksuite_db}
    ports:
      - "${DB_PORT:-5432}:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data
      - ./database/init.sql:/docker-entrypoint-initdb.d/init.sql
    networks:
      - asksuite-network
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${DB_USER:-asksuite}"]
      interval: 10s
      timeout: 5s
      retries: 5

  # Redis Cache
  redis:
    image: redis:7-alpine
    container_name: asksuite-redis
    restart: unless-stopped
    ports:
      - "${REDIS_PORT:-6379}:6379"
    volumes:
      - redis_data:/data
    networks:
      - asksuite-network
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 3s
      retries: 5
    command: redis-server --appendonly yes

  # PgAdmin (Opcional - útil para desenvolvimento)
  pgadmin:
    image: dpage/pgadmin4:latest
    container_name: asksuite-pgadmin
    restart: unless-stopped
    environment:
      - PGADMIN_DEFAULT_EMAIL=${PGADMIN_EMAIL:-admin@asksuite.com}
      - PGADMIN_DEFAULT_PASSWORD=${PGADMIN_PASSWORD:-admin}
    ports:
      - "${PGADMIN_PORT:-5050}:80"
    depends_on:
      - postgres
    networks:
      - asksuite-network
    profiles:
      - dev

volumes:
  postgres_data:
    driver: local
  redis_data:
    driver: local

networks:
  asksuite-network:
    driver: bridge
