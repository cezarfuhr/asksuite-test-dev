# Orchestrator Configuration
ORCHESTRATOR_PORT=8080
PUPPETEER_SERVICE_URL=http://scraper-puppeteer:3001
PLAYWRIGHT_SERVICE_URL=http://scraper-playwright:3002

# A/B Testing Configuration
PLAYWRIGHT_TRAFFIC_PERCENTAGE=20

# Circuit Breaker Configuration
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=30000
CIRCUIT_BREAKER_SUCCESS_THRESHOLD=2

# Scraper Configuration
SCRAPER_TIMEOUT=60000
MAX_CONCURRENT_SCRAPES=5

# Puppeteer Configuration
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# Redis Configuration
REDIS_URL=redis://redis:6379

# PostgreSQL Configuration
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/asksuite
POSTGRES_DB=asksuite
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Feature Flags
FEATURE_COMPARISON_MODE=false
FEATURE_MOCK_FALLBACK=false
FEATURE_CACHE_ENABLED=true
CACHE_TTL=3600

# Logging
LOG_LEVEL=info
